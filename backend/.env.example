# Server-side admin trust configuration.
# Client-provided x-user-role is not enough to become admin in production.
#
# Comma-separated Firebase uid values that may use admin/developer/platform roles.
ADMIN_USER_IDS=

# Comma-separated admin emails. Keep this narrow and audited.
ADMIN_EMAILS=

# Optional machine-to-machine admin secret for internal tools.
# Do not expose this in frontend code.
ADMIN_API_SECRET=

# Optional Firebase Auth verification.
# Set REQUIRE_FIREBASE_AUTH=true only after FIREBASE_PROJECT_ID and credentials are configured.
FIREBASE_PROJECT_ID=teach999-53c2d
FIREBASE_SERVICE_ACCOUNT_JSON=
REQUIRE_FIREBASE_AUTH=false
